# Bu dosyayi proje kok klasorune ".gitignore" adiyla kaydedin.
# (Dosya adinin basindaki nokta onemlidir.)

# Sanal ortam
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Indirilen model onbellegi (GB boyutunda, depoya yuklenmez)
.cache/
models/
*.safetensors
*.bin

# Isletim sistemi
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Gecici dosyalar
*.tmp
*.log
~$*

# LaTeX ara ciktilari
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc

